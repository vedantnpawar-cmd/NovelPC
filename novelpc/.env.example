# Copy this file to ".env" (same folder as app.py) and fill in your real values.
# ".env" is gitignored — it will never be committed or pushed to GitHub.

# Get these from https://dashboard.razorpay.com/app/keys
# Use the TEST keys first (they start with rzp_test_) until you're ready to go live,
# then switch to the LIVE keys (rzp_live_) once KYC is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Existing app secrets (already used by app.py) — set these too if you haven't.
SECRET_KEY=
ADMIN_PASSWORD=
